class ContaBancaria {
    private saldo: number = 0;

    public depositar(valor: number): void {
        if (valor > 0) {
            this.saldo += valor;
        }
    }

    public sacar(valor: number): boolean {
        if (valor > 0 && this.saldo >= valor) {
            this.saldo -= valor;
            return true;
        }
        return false;
    }

    public consultarSaldo(): number {
        return this.saldo;
    }
}
